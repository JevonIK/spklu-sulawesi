# Salin berkas ini menjadi .env untuk pengembangan lokal.
# Jangan pernah memasukkan .env atau API key ke GitHub.
APP_ENV=development
SECRET_KEY=ganti-dengan-secret-key-lokal
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true
MAX_CONTENT_LENGTH=65536

# Wajib pada produksi. Pisahkan dengan koma dan sertakan 127.0.0.1 agar
# Docker HEALTHCHECK dapat mengakses endpoint health.
TRUSTED_HOSTS=localhost,127.0.0.1
# Aktifkan hanya jika aplikasi benar-benar berada di belakang satu reverse proxy
# tepercaya yang mengirim X-Forwarded-For, X-Forwarded-Proto, dan X-Forwarded-Host.
USE_PROXY_FIX=false
PUBLIC_CONTACT_EMAIL=
# Opsional pada deployment/eksperimen: isi dengan ID commit atau tag rilis.
SOURCE_REVISION=

# Lokasi dataset dapat berupa path absolut atau relatif terhadap root proyek.
DATASET_PATH=dataset_spklu_sulawesi.csv

# Default backend. Antarmuka umum hanya menampilkan SOC minimum dan target;
# safety factor, radius koridor, langkah sampling, dan interval SOC dikelola
# oleh backend. Eksperimen CLI tetap dapat mengirim variasi terdokumentasi.
DEFAULT_SOC_MIN=20
DEFAULT_SOC_TARGET=80
DEFAULT_CURRENT_SOC=80
# Median tujuh model-family WLTP resmi Indonesia = 433 km, dibulatkan ke
# 10 km terdekat menjadi baseline 430 km. Pengguna tetap mengisi range aktual.
DEFAULT_MAXIMUM_RANGE_KM=430
DEFAULT_SAFETY_FACTOR=0.90
DEFAULT_CORRIDOR_RADIUS_KM=10
# Batas total detour baseline diturunkan dari 2 × radius koridor 10 km.
DEFAULT_MAX_TOTAL_DETOUR_KM=20
DEFAULT_ROUTE_SAMPLE_STEP_KM=5
DEFAULT_SOC_STEP=5

# Key browser dibatasi ke domain aplikasi dan Maps JavaScript + Places API.
# Key server dibatasi ke Routes API dan IP server ketika sudah deployment.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
# Gunakan DEMO_MAP_ID untuk lokal; ganti dengan Map ID sendiri saat deployment.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
GOOGLE_ROUTES_TIMEOUT_SECONDS=20

# Ledger Routes CLI/web mengikuti reset kuota Google pada tengah malam
# Pacific Time. Samakan kedua batas harian dengan quota project di Cloud Console.
GOOGLE_QUOTA_LEDGER_PATH=reports/generated/google-routes-quota.json
GOOGLE_QUOTA_TIMEZONE=America/Los_Angeles
GOOGLE_COMPUTE_ROUTES_DAILY_LIMIT=100
GOOGLE_ROUTE_MATRIX_DAILY_ELEMENT_LIMIT=2000
GOOGLE_COMPUTE_ROUTES_PER_MINUTE_LIMIT=100
GOOGLE_ROUTE_MATRIX_PER_MINUTE_ELEMENT_LIMIT=2000
# Satu rekomendasi memakai maksimal satu rute dasar dan satu rute akhir.
# Batas per menit disamakan dengan batas harian agar tidak memaksa jeda,
# sementara batas per request dan ledger harian tetap membatasi pemakaian.
GOOGLE_WEB_MAX_COMPUTE_ROUTES_PER_REQUEST=2
GOOGLE_WEB_MAX_MATRIX_ELEMENTS_PER_REQUEST=625

# Server produksi Gunicorn. Nilai awal konservatif untuk prototipe penelitian.
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
