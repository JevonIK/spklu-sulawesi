# Salin berkas ini menjadi .env untuk pengembangan lokal.
# Jangan pernah memasukkan .env atau API key ke GitHub.
APP_ENV=development
SECRET_KEY=ganti-dengan-secret-key-lokal
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true
MAX_CONTENT_LENGTH=65536

# Wajib pada produksi. Pisahkan dengan koma dan sertakan 127.0.0.1 agar
# Docker HEALTHCHECK dapat mengakses endpoint health.
TRUSTED_HOSTS=localhost,127.0.0.1
# Aktifkan hanya jika aplikasi benar-benar berada di belakang satu reverse proxy
# tepercaya yang mengirim X-Forwarded-For, X-Forwarded-Proto, dan X-Forwarded-Host.
USE_PROXY_FIX=false
PUBLIC_CONTACT_EMAIL=

# Lokasi dataset dapat berupa path absolut atau relatif terhadap root proyek.
DATASET_PATH=dataset_spklu_sulawesi.csv

# Parameter awal penelitian. Nilai ini akan dapat diubah melalui antarmuka.
DEFAULT_SOC_MIN=20
DEFAULT_SOC_TARGET=80
DEFAULT_SAFETY_FACTOR=0.90
DEFAULT_CORRIDOR_RADIUS_KM=10
DEFAULT_ROUTE_SAMPLE_STEP_KM=5
DEFAULT_SOC_STEP=5

# Key browser dibatasi ke domain aplikasi dan Maps JavaScript + Places API.
# Key server dibatasi ke Routes API dan IP server ketika sudah deployment.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
# Gunakan DEMO_MAP_ID untuk lokal; ganti dengan Map ID sendiri saat deployment.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
GOOGLE_ROUTES_TIMEOUT_SECONDS=20

# Ledger lokal eksperimen mengikuti reset kuota Google pada tengah malam
# Pacific Time. Samakan kedua batas harian dengan quota project di Cloud Console.
GOOGLE_QUOTA_LEDGER_PATH=reports/generated/google-routes-quota.json
GOOGLE_QUOTA_TIMEZONE=America/Los_Angeles
GOOGLE_COMPUTE_ROUTES_DAILY_LIMIT=100
GOOGLE_ROUTE_MATRIX_DAILY_ELEMENT_LIMIT=2000

# Server produksi Gunicorn. Nilai awal konservatif untuk prototipe penelitian.
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
